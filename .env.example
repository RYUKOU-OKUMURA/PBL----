# WordPress（post_to_wp.py / analyze_content_seo.py）
WP_URL=https://your-site.com
WP_USER=your_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# GA4（analyze_content_seo.py）
# Google Cloud でサービスアカウント作成 → GA4プロパティに閲覧者として追加
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Search Console（analyze_content_seo.py）
# 上記と同じサービスアカウントを Search Console のプロパティに追加
# 未設定時は WP_URL から自動推測
GSC_SITE_URL=https://physical-balance-lab.com
